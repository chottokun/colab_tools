# Google Cloud クオータプロジェクト（colaboratory.googleapis.com API を有効化したプロジェクト ID）
COLAB_QUOTA_PROJECT="YOUR_GCP_PROJECT_ID"

# Google Colab API / MCP アクセストークン（ADC 自動更新を使う場合は未設定を推奨）
# COLAB_API_TOKEN="YOUR_GOOGLE_CLOUD_OAUTH_ACCESS_TOKEN"

# 既定のランタイム設定（任意）
COLAB_DEFAULT_VARIANT="VARIANT_CPU"
COLAB_DEFAULT_ACCELERATOR="NONE"
COLAB_DEFAULT_SHAPE="SHAPE_STANDARD"
